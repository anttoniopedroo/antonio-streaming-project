# Configuração do FRONT-END (site). Copie para .env.
#
# Estes valores são PÚBLICOS por natureza (vão para o navegador).
# NÃO coloque aqui a chave secreta do Supabase nem a chave da sua API:
# essas ficam em server/chave_api.env.
#
# Painel do Supabase > Project Settings > API (ou "API Keys")

# Project URL. Exemplo: https://abcdefghijklmnop.supabase.co
VITE_SUPABASE_URL=

# Chave pública: "publishable" (sb_publishable_...) ou a antiga "anon".
VITE_SUPABASE_ANON_KEY=
