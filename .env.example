# Configuração do FRONT-END (site). Copie para .env.
#
# NÃO coloque a chave da API aqui: tudo que começa com VITE_ fica visível no navegador.
# A chave fica no back-end, em server/chave_api.env.
#
# Vazio  -> o site usa os dados de demonstração (src/data/mockTitles.js).
# /api   -> o site passa a usar o back-end, que chama a sua API com a chave.
VITE_API_BASE_URL=
