# =========================================================
#  CHAVES SECRETAS — arquivo SECRETO (fica só no servidor)
# =========================================================
#  - Este arquivo NUNCA vai para o navegador.
#  - Não envie para o GitHub (já está no .gitignore).
#  - Depois de editar, reinicie o projeto (npm run dev:all).


# ---------------------------------------------------------
#  1) LOGIN — Supabase
# ---------------------------------------------------------
#  Painel do Supabase > Project Settings > API (ou "API Keys")

# Project URL. Exemplo: https://abcdefghijklmnop.supabase.co
SUPABASE_URL=

# >>> A CHAVE SECRETA DO SUPABASE ENTRA AQUI <<<
# Chave "secret" (sb_secret_...) ou a antiga "service_role".
# NUNCA use esta chave no site nem no arquivo .env da raiz.
SUPABASE_SECRET_KEY=


# ---------------------------------------------------------
#  2) SUA API AUTORIZADA (catálogo)
# ---------------------------------------------------------
#  Enquanto ficar vazio, o site usa o catálogo de demonstração.

# Endereço base da sua API autorizada (sem barra no final).
# Exemplo: https://api.seuprovedor.com/v1
API_BASE_URL=

# >>> A CHAVE DA API ENTRA AQUI <<<
# Cole sua chave logo depois do "=", sem aspas e sem espaços.
API_KEY=

# Como a sua API espera receber a chave (veja a documentação do seu provedor)
# Opção 1 (padrão): no cabeçalho HTTP.
#   Authorization: Bearer SUA_CHAVE  -> API_KEY_HEADER=Authorization e API_KEY_PREFIX=Bearer
#   x-api-key: SUA_CHAVE             -> API_KEY_HEADER=x-api-key     e API_KEY_PREFIX= (vazio)
API_KEY_HEADER=Authorization
API_KEY_PREFIX=Bearer

# Opção 2: na URL, ex: ?api_key=SUA_CHAVE
# Preencha com o nome do parâmetro (ex: api_key). Se preenchido, o cabeçalho acima é ignorado.
API_KEY_QUERY_PARAM=


# ---------------------------------------------------------
#  3) Porta do back-end local
# ---------------------------------------------------------
PORT=3001
