    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.11",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^10.0.6",
    "vite": "^5.4.11"
  }
}
